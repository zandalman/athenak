# AthenaK input file for the TDE stream-injection problem, M_BH = 3e6 Msun
# (table data/inj_3e6.ascii: rp = 11.33, a_mb = 462.4, tinj = 384.9).
# Requires a build configured with -D PROBLEM=injection.
# Units: G = M_BH = c = 1 (lengths in r_g, times in r_g/c).
#
# Telescoping SMR around the BH: 4096^3 r_g box, 128^3 root grid (dx0 = 32 r_g), and
# nested cubes |x|,|y|,|z| <= 2^(11-l) at level l = 1..7, i.e. level = 11 - log2(r) and
# dx ~ |x|/64.  The finest cells (level 7, |x| <= 16) have dx = 0.25 r_g, so the
# excision r_in = 8 is 32 finest cells in radius.  Each nested cube is 128^3 cells at its
# own level; with 32^3 MeshBlocks every cube edge falls on a parent-block edge, so the
# regions are not padded outward.  456 MeshBlocks around the BH.
# The SI point (r ~ 204 -> 255 by tlim) is ~8x inside the box half-width (~4x at 1e6).
#
# AMR: blocks anywhere with cold stream gas (density > amr_rho_min, low entropy) are
# refined to amr_level = 7 (dx = 0.25, so H = 1.67 is ~6.7 cells), the finest level
# anywhere.  The pgen also keeps a box around each injection cylinder (padded by inj_pad)
# and around the SI point (si_pad) at amr_level while the table is on now or at
# t + inj_lead; downstream the density criterion keeps the streams refined.
# Refinement is adaptive, so the pgen keeps every <refined_regionN> as a minimum level
# (refined regions only set the initial mesh under AMR), except initial_only ones.

<comment>
problem   = TDE stream injection near the self-intersection point (skeleton)
reference = Tejeda & Rosswog 2013, MNRAS 433, 1930 (TR13 potential)

<job>
basename = injection

<units>                       # M_BH = 3e6 Msun (3 x the 1e6 values), G = M = c = 1
length_cgs = 4.4312802e+11    # r_g
mass_cgs   = 5.9673e+39       # M_BH
time_cgs   = 14.7811818       # r_g/c

<mesh>
nghost = 2
nx1    = 128
x1min  = -2048.0
x1max  = 2048.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 128
x2min  = -2048.0
x2max  = 2048.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 128
x3min  = -2048.0
x3max  = 2048.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<mesh_refinement>
refinement          = adaptive
num_levels          = 8       # root + 7 levels (finest dx = 0.25)
ncycle_check        = 128     # fine ticks between AMR checks (one level per check)
refinement_interval = 128
max_nmb_per_rank    = 1500    # ~15% below the measured ~1800-block OOM limit of one
                              # Stellar GPU (see docs/notes.md, 2026-11-09)

<amr_criterion0>
method = user                 # InjectionRefinement in injection.cpp

<refined_region1>             # dx = 16
level = 1
x1min = -1024.0
x1max = 1024.0
x2min = -1024.0
x2max = 1024.0
x3min = -1024.0
x3max = 1024.0

<refined_region2>             # dx = 8
level = 2
x1min = -512.0
x1max = 512.0
x2min = -512.0
x2max = 512.0
x3min = -512.0
x3max = 512.0

<refined_region3>             # dx = 4
level = 3
x1min = -256.0
x1max = 256.0
x2min = -256.0
x2max = 256.0
x3min = -256.0
x3max = 256.0

<refined_region4>             # dx = 2
level = 4
x1min = -128.0
x1max = 128.0
x2min = -128.0
x2max = 128.0
x3min = -128.0
x3max = 128.0

<refined_region5>             # dx = 1
level = 5
x1min = -64.0
x1max = 64.0
x2min = -64.0
x2max = 64.0
x3min = -64.0
x3max = 64.0

<refined_region6>             # dx = 0.5
level = 6
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -32.0
x3max = 32.0

<refined_region7>             # dx = 0.25
level = 7
x1min = -16.0
x1max = 16.0
x2min = -16.0
x2max = 16.0
x3min = -16.0
x3max = 16.0

# Initial injection site at start_time, dx = 0.25.  initial_only: these only build the
# initial mesh (the table is on at t0, so the pgen's look-ahead cannot pre-refine it, and
# V_cyl assumes the cylinders sit on amr_level); the pgen's boxes take over afterwards.
# One region per pgen box at t0 (incl. the inj_lead = 750 look-ahead), rounded out to
# 8 r_g block edges (8 + 18 + 8 = 34 blocks).

<refined_region8>             # inbound cylinder: x [-222.7, -214.6], y [-92.4, -84.5]
level = 7
initial_only = true
x1min = -224.0
x1max = -208.0
x2min = -96.0
x2max = -80.0
x3min = -8.0
x3max = 8.0

<refined_region9>             # collision (SI) box: x [-195.0, -178.6], y [-92.0, -75.8]
level = 7
initial_only = true
x1min = -200.0
x1max = -176.0
x2min = -96.0
x2max = -72.0
x3min = -8.0
x3max = 8.0

<refined_region10>            # outbound cylinder: x [-163.1, -155.0], y [-65.7, -57.8]
level = 7
initial_only = true
x1min = -168.0
x1max = -152.0
x2min = -72.0
x2max = -56.0
x3min = -8.0
x3max = 8.0

<time>
evolution  = dynamic
integrator = rk2              # LAT supports rk1, rk2, imex2 only
cfl_number = 0.4              # margin: a LAT neighbour may step up to 2x its own limit
nlim       = -1
start_time = 6.409628451621320e+04   # first time in the injection table
tlim       = 1.1547e6         # = 2e6 / sqrt(3): the 1e6 run's tlim in units of the
                              # fallback time (t_mb ~ M^-1/2 in r_g/c, as tinj)
ndiag      = 1

lat               = true
lat_levels        = 6         # factors up to 2^6: window = max factor = 64 fine ticks
                              # (was 8 / 256), so the CIO front moves only a fraction of
                              # a block per window and the pinned neighbour ring holds it
lat_same_level    = true      # blocks on one level may step at different rates
                              # (lat_same_level_max_ratio defaults to 2)
lat_min_bin_count = 8         # set explicitly so runs are reproducible across rank counts
lat_pin_density   = 1.0e-16   # blocks with stream gas and their neighbours step at
                              # factor 1: ~0.1 of the lowest stream density in the run
                              # (1.4e-15, outbound at t0); above the excision density
                              # (~1.6e-22)
lat_pin_density_contrast = 1.0e3  # blocks whose own max/min density >= 1e3, and their
                              # neighbours, step at factor 1: pins the CIO/background
                              # front, whose thin edge is below lat_pin_density
                              # (NaN blow-up at the collision, 2026-11-11)

<hydro>
eos         = ideal
gamma       = 1.3333333333333333
reconstruct = plm
rsolver     = hllc
dfloor      = 1.0e-28         # below the background everywhere (~1.4e-25 at box corners)
pfloor      = 1.0e-34
vceil       = 0.5             # |v| cap [c]; Newtonian, so v ~ c is unphysical anyway
                              # (TR13 free fall at r_in = 8 is ~0.38)
cs_ceil     = 0.5             # sound-speed cap [c]; atmosphere c_s(r_in) ~ 0.19
dual_energy = true            # separate internal energy: the stream is Mach ~300 at t0,
                              # >1000 by tlim (eta1 default 1e-3)
fofc        = true            # first-order LLF fluxes on cells whose stage update would
                              # need a floor: trial for the bad cells that start at the
                              # stream collision (docs/notes.md, 2026-11-11)

<problem>
user_srcs = true              # TR13 gravity (enrolled by the pgen regardless)

r_in    = 8.0                 # excision radius [r_g], must be > 2 and < rp = 11.33
                              # (rp/r_in = 1.42, as 23.56/16 at 1e6); 32 finest cells in radius
bern    = 0.01                # atmosphere Bernoulli constant: h = bern - Phi_s(r), so
                              # rho is ~flat for r >> 1/bern = 100 and rises only inside
rho_atm = 1.0e-24             # atmosphere density at r_atm.  100x below the 1e6 deck, to
                              # keep P_bg << P_stream after lowering temp.  With bern = 0.01:
                              # rho ~ 3.7e-25 / 5.1e-25, P ~ 1e-5 / 2e-5 P_stream,
                              # c_s ~ 0.07 at the inbound / outbound injection points
                              # (r ~ 236 / 170); rho ~ 1.4e-25 at the box corners;
                              # rho ~ 1.6e-22, c_s ~ 0.19 at r_in
r_atm   = 100.0               # atmosphere normalization radius [r_g]

amr_level   = 7               # dx = 0.25 for stream gas anywhere (and the pgen boxes)
amr_rho_min = 1.0e-16         # ~0.1 of the lowest stream density in the run (1.4e-15,
                              # outbound at t0; inbound 3.2e-15; ~3e-14 / 4e-14 at tlim)
amr_entropy_fac = 3.0       # ...and only gas with P/rho^gamma < this x the (larger)
                              # injected stream entropy, i.e. the cold streams, not the
                              # shock-heated CIO (estimated ~1e4 x stream entropy)
inj_lead    = 750.0           # look-ahead [r_g/c]: injection boxes are enforced from
                              # inj_lead before each on phase.  The sites sit on BH-nest
                              # levels 2-3 (SI on 3), so this must cover up to 5 AMR
                              # checks (~115 r_g/c at a fine tick ~0.18); ~6x margin.
                              # Halved from 1500: on/off phases are only ~3300 here
inj_pad     = 2.0             # injection-box padding [r_g] (cylinders drift ~0.01 r_g
                              # per window; the box also spans t .. t + inj_lead)
si_pad      = 8.0             # collision box: SI point (xc, yc) at t .. t + inj_lead,
                              # padded by si_pad in x, y and z, held at amr_level with the
                              # injection boxes, so the collision is never at a level
                              # boundary (8 = one dx = 0.25 block, ~5 H); also held for
                              # tinj after each off switch, while injected gas still arrives
tinj        = 384.9001795     # stream travel time injection -> SI [r_g/c]; must match the
                              # tinj used to build inj_file (see its header).  The pgen's
                              # endpoint test needs phases (~3300) > tinj + inj_lead (1135)

# Streams: inbound and outbound, from the injection table (columns t, state, xc, yc,
# x_in, y_in, vx_in, vy_in, x_out, ..., mdot_in, mdot_out; code units; row t = injection
# time).  Interpolated linearly in t once per LAT window; state (on/off) from the row at
# or before t.  Each injected over a cylinder of radius H and length H centred on the
# table position (z = 0), axis along the table velocity; rho_s = mdot/(pi H^2 v).
inj_file = data/inj_3e6.ascii # relative to the run directory
H        = 1.67               # stream radius [r_g], both streams: the 1e6 deck's 5 r_g at
                              # fixed physical width (5/3); ~6.7 cells at dx = 0.25
temp     = 8.0e4              # K, radiation temperature: e = a_rad T^4, both streams.
                              # Chosen with tinj = 1155 so the stream stays as cold as at
                              # 1e6 (c_s tinj ~ 0.3 H, outbound at t0).  With tinj = 385 the
                              # spread is only ~0.07 H (colder than needed; ~8e4 K would
                              # match 0.3 H).  P_stream = 1.05e-22 code

<output1>
file_type = hst               # hydro totals + user columns M_inj (cumulative injected
dt        = 100.0             # mass), M_exc (cumulative mass removed by the excision),
                              # mdot_in, mdot_out, inj_on (current window's streams)

<output2>
file_type = bin
variable  = hydro_w
id        = hydro2dz
dt        = 100.0
slice_x3  = 0.0

<output3>
file_type = bin
variable  = hydro_w
id        = hydro2dy
dt        = 100.0
slice_x2  = 0.0

<output4>
file_type = bin
variable  = hydro_w
id        = hydro3d
dt        = 10000.0

<output5>
file_type = rst
id        = restart
dt        = 10000.0

<output6>
file_type = log                 # floor/ceiling/c2p-failure counts (injection.log), written
dcycle    = 100                 # only on cycles where a counter is non-zero
