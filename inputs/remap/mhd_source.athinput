<comment>
problem = remap battery: MHD analytic source (remap_test source mode).  Writes the
source restart at cycle 0.  Resolution overridden from the command line per case.

<job>
basename = RTSrc

<mesh>
nghost = 2
nx1 = 48
x1min = -1.0
x1max = 1.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 48
x2min = -1.0
x2max = 1.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 48
x3min = -1.0
x3max = 1.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 0
tlim = 10.0
ndiag = 1

<mhd>
eos = ideal
gamma = 1.6666666666666667
reconstruct = plm
rsolver = hlld
dfloor = 1.0e-8
pfloor = 1.0e-10

<problem>
pgen_name = remap_test

<output1>
file_type = rst
dt = 1.0
