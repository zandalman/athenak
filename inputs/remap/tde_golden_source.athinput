<comment>
problem = T-G golden source: mini tde_external run that writes the remap-source restart.
Ideal EOS + dual energy, legacy polytrope, uniform mesh. See docs/design/remap_module_design.md.

<job>
basename = TDEGoldenSrc

<mesh>
nghost = 2
nx1 = 64
x1min = -8.0
x1max = 8.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 64
x2min = -8.0
x2max = 8.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 64
x3min = -8.0
x3max = 8.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<units>
mass_cgs = 1.98841586e33
length_cgs = 1.3914e11
time_cgs = 1.2709152632111343e3
mu = 1.0

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.4
nlim = -1
tlim = 0.05
ndiag = 1

<hydro>
eos = ideal
gamma = 1.6666666666666667
reconstruct = plm
rsolver = hlle
dfloor = 1.0e-10
pfloor = 1.0e-12
dual_energy = true
dual_energy_eta1 = 1.0e-3
dual_energy_eta2 = 1.0e-4

<gravity>
self_gravity = false
four_pi_G = 1.0

<problem>
pgen_name = tde_external
user_srcs = true

star_radius = 0.5
poly_n = 1.5
stellar_structure_mode = legacy_polytrope
rho_floor = 1.0e-10
relax_damp = false
amp = 0.0
x_center = 0.0
y_center = 0.0
z_center = 0.0
vx_star = 0.0
vy_star = 0.0
vz_star = 0.0
use_translating_frame = true
frame_rho_min = 1.0e-9
bh_grav_rho_min = 1.0e-9

mass_ratio = 1000.0
beta = 1.0
ecc_bh = 1.0
theta_bh = 0.0
sep_initial = 6.0
bh_softening = 5.0e-3
bh_inner_boundary = true
bh_excise_radius = 0.2

<output1>
file_type = rst
dt = 0.04
