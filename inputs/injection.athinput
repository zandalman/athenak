# AthenaK input file for the TDE stream-injection problem.
# Requires a build configured with -D PROBLEM=injection.
# Units: G = M_BH = c = 1 (lengths in r_g, times in r_g/c).
#
# Telescoping SMR around the BH: 8192^3 r_g box, 128^3 root grid (dx0 = 64 r_g), and
# nested cubes |x|,|y|,|z| <= 2^(12-l) at level l = 1..7, i.e. level = 12 - log2(r) and
# dx ~ |x|/64.  The finest BH cells (level 7, |x| <= 32) have dx = 0.5 r_g; no finer
# level, since r < r_in = 16 is excised.  Each nested cube is 128^3 cells at its own
# level; with 32^3 MeshBlocks every cube edge falls on a parent-block edge, so the
# regions are not padded outward.  456 MeshBlocks around the BH.
#
# AMR: blocks anywhere whose max density exceeds amr_rho_min are refined to
# amr_level = 7 (dx = 0.5), the finest level anywhere.  The pgen also keeps a box around
# each injection cylinder (padded by inj_pad) at amr_level while the table is on now or
# at t + inj_lead; downstream the density criterion keeps the streams refined.
# Refinement is adaptive, so the pgen keeps every <refined_regionN> as a minimum level
# (refined regions only set the initial mesh under AMR), except initial_only ones.

<comment>
problem   = TDE stream injection near the self-intersection point (skeleton)
reference = Tejeda & Rosswog 2013, MNRAS 433, 1930 (TR13 potential)

<job>
basename = injection

<units>                       # M_BH = 1e6 Msun, G = M = c = 1 (as ref/athinput.tde_si)
length_cgs = 1.4770934e+11    # r_g
mass_cgs   = 1.9891e+39       # M_BH
time_cgs   = 4.9270606        # r_g/c

<mesh>
nghost = 2
nx1    = 128
x1min  = -4096.0
x1max  = 4096.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 128
x2min  = -4096.0
x2max  = 4096.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 128
x3min  = -4096.0
x3max  = 4096.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<mesh_refinement>
refinement          = adaptive
num_levels          = 8       # root + 7 levels (finest dx = 0.5)
ncycle_check        = 128     # fine ticks between AMR checks (one level per check)
refinement_interval = 128
max_nmb_per_rank    = 1500    # ~15% below the measured ~1800-block OOM limit of one
                              # Stellar GPU (see docs/notes.md, 2026-11-09)

<amr_criterion0>
method = user                 # InjectionRefinement in injection.cpp

<refined_region1>             # dx = 32
level = 1
x1min = -2048.0
x1max = 2048.0
x2min = -2048.0
x2max = 2048.0
x3min = -2048.0
x3max = 2048.0

<refined_region2>             # dx = 16
level = 2
x1min = -1024.0
x1max = 1024.0
x2min = -1024.0
x2max = 1024.0
x3min = -1024.0
x3max = 1024.0

<refined_region3>             # dx = 8
level = 3
x1min = -512.0
x1max = 512.0
x2min = -512.0
x2max = 512.0
x3min = -512.0
x3max = 512.0

<refined_region4>             # dx = 4
level = 4
x1min = -256.0
x1max = 256.0
x2min = -256.0
x2max = 256.0
x3min = -256.0
x3max = 256.0

<refined_region5>             # dx = 2
level = 5
x1min = -128.0
x1max = 128.0
x2min = -128.0
x2max = 128.0
x3min = -128.0
x3max = 128.0

<refined_region6>             # dx = 1
level = 6
x1min = -64.0
x1max = 64.0
x2min = -64.0
x2max = 64.0
x3min = -64.0
x3max = 64.0

<refined_region7>             # dx = 0.5
level = 7
x1min = -32.0
x1max = 32.0
x2min = -32.0
x2max = 32.0
x3min = -32.0
x3max = 32.0

<refined_region8>             # initial injection site at start_time (SI point and both
level = 7                     # injection cylinders, padded); dx = 0.5.  Only builds the
initial_only = true           # initial mesh: the pgen's injection boxes take over (the
x1min = -944.0                # rest derefines unless dense).  tinj = 2000 table, union of
x1max = -800.0                # the pgen boxes at t0 (incl. inj_lead look-ahead):
x2min = -208.0                # x [-934.9, -802.7], y [-207.3, -156.6], z [-16, 16],
x2max = -144.0                # rounded out to 16 r_g block edges (9 x 4 x 2 blocks)
x3min = -16.0
x3max = 16.0

<time>
evolution  = dynamic
integrator = rk2              # LAT supports rk1, rk2, imex2 only
cfl_number = 0.4              # margin: a LAT neighbour may step up to 2x its own limit
nlim       = -1
start_time = 1.255039907173705e+05   # first time in the injection table
tlim       = 2.0e6
ndiag      = 1

lat               = true
lat_levels        = 6         # factors up to 2^6: window = max factor = 64 fine ticks
                              # (was 8 / 256), so the CIO front moves only a fraction of
                              # a block per window and the pinned neighbour ring holds it
lat_same_level    = true      # blocks on one level may step at different rates
                              # (lat_same_level_max_ratio defaults to 2)
lat_min_bin_count = 8         # set explicitly so runs are reproducible across rank counts
lat_pin_density   = 1.0e-16   # blocks with stream gas and their neighbours step at
                              # factor 1: ~0.1 of the lowest stream density in the run
                              # (9.2e-16, outbound at t0); above the excision density
                              # (~3.5e-21)
lat_pin_density_contrast = 1.0e3  # blocks whose own max/min density >= 1e3, and their
                              # neighbours, step at factor 1: pins the CIO/background
                              # front (~1e8 jump), whose thin edge is below
                              # lat_pin_density (NaN blow-up at the collision, 2026-11-11)

<hydro>
eos         = ideal
gamma       = 1.3333333333333333
reconstruct = plm
rsolver     = hllc
dfloor      = 1.0e-28         # below the background everywhere (~1.3e-23 at box corners)
pfloor      = 1.0e-34
vceil       = 0.5             # |v| cap [c]; Newtonian, so v ~ c is unphysical anyway
                              # (free fall at r_in = 16 is ~0.35)
cs_ceil     = 0.5             # sound-speed cap [c]; atmosphere c_s(r_in) ~ 0.13
dual_energy = true            # separate internal energy: the stream is Mach ~300, so
                              # E - K is truncation noise there (eta1 default 1e-3)
fofc        = true            # first-order LLF fluxes on cells whose stage update would
                              # need a floor: trial for the bad cells that start at the
                              # stream collision (docs/notes.md, 2026-11-11)

<problem>
user_srcs = true              # TR13 gravity (enrolled by the pgen regardless)

r_in    = 16.0                # excision radius [r_g], must be > 2 (32 finest cells in radius)
bern    = 0.01                # atmosphere Bernoulli constant: h = bern - Phi_s(r), so
                              # rho is ~flat for r >> 1/bern = 100 and rises only inside
rho_atm = 1.0e-22             # atmosphere density at r_atm.  With bern = 0.01:
                              # rho ~ 1.7e-23, P ~ 1e-4 P_stream, c_s ~ 0.06 at the
                              # injection points; rho ~ 1.3e-23 at the box corners;
                              # rho ~ 3.5e-21, c_s ~ 0.147 at r_in (~1e-5 of the
                              # estimated CIO fallback there)
r_atm   = 100.0               # atmosphere normalization radius [r_g]

amr_level   = 7               # dx = 0.5 for dense gas anywhere (and the injection boxes)
amr_rho_min = 1.0e-16         # ~0.1 of the lowest stream density in the run (9.2e-16,
                              # outbound at t0; both streams ~2e-14 at t = 2e6)
amr_entropy_fac = 3.0       # ...and only gas with P/rho^gamma < this x the (larger)
                              # injected stream entropy, i.e. the cold streams, not the
                              # shock-heated CIO (estimated ~1e4 x stream entropy)
inj_lead    = 1500.0          # look-ahead [r_g/c]: injection boxes are enforced from
                              # inj_lead before each on phase.  The site sits on BH-nest
                              # level 0-2 and AMR adds one level per check, so this must
                              # cover up to 7 AMR checks (one per 128 fine ticks)
inj_pad     = 2.0             # injection-box padding [r_g] (cylinders drift ~0.3 r_g
                              # per window; the box also spans t .. t + inj_lead)
si_pad      = 16.0            # collision box: SI point (xc, yc) at t .. t + inj_lead,
                              # padded by si_pad in x, y and z, held at amr_level with the
                              # injection boxes, so the collision is never at a level
                              # boundary (16 = one dx = 0.5 block); also held for tinj
                              # after each off switch, while injected gas still arrives
tinj        = 2000.0          # stream travel time injection -> SI [r_g/c]; must match the
                              # tinj used to build inj_file (see its header)

# Streams: inbound and outbound, from the injection table (columns t, state, xc, yc,
# x_in, y_in, vx_in, vy_in, x_out, ..., mdot_in, mdot_out; code units; row t = injection
# time).  Interpolated linearly in t once per LAT window; state (on/off) from the row at
# or before t.  Each injected over a cylinder of radius H and length H centred on the
# table position (z = 0), axis along the table velocity; rho_s = mdot/(pi H^2 v).
inj_file = data/inj.ascii     # relative to the run directory
H        = 5.0                # stream radius [r_g], both streams
temp     = 1.0e5              # K, radiation temperature: e = a_rad T^4, both streams

<output1>
file_type = hst               # hydro totals + user columns M_inj (cumulative injected
dt        = 100.0             # mass), M_exc (cumulative mass removed by the excision),
                              # mdot_in, mdot_out, inj_on (current window's streams)

<output2>
file_type = bin
variable  = hydro_w
id        = hydro2dz
dt        = 100.0
slice_x3  = 0.0

<output3>
file_type = bin
variable  = hydro_w
id        = hydro2dy
dt        = 100.0
slice_x2  = 0.0

<output4>
file_type = bin
variable  = hydro_w
id        = hydro3d
dt        = 10000.0

<output5>
file_type = rst
id        = restart
dt        = 10000.0

<output6>
file_type = log                 # floor/ceiling/c2p-failure counts (injection.log), written
dcycle    = 100                 # only on cycles where a counter is non-zero
