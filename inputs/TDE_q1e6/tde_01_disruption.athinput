<comment>
problem = TDE: 1 Msun star, M_BH/M_star = 1e+06, beta = 1, wegg BH potential, step 1

<job>
basename = TDE_q1e06

<mesh>
nghost = 2
nx1    = 32
x1min  = -16
x1max  = 16
ix1_bc = outflow_only
ox1_bc = outflow_only
nx2    = 32
x2min  = -16
x2max  = 16
ix2_bc = outflow_only
ox2_bc = outflow_only
nx3    = 32
x3min  = -16
x3max  = 16
ix3_bc = outflow_only
ox3_bc = outflow_only

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<units>
mass_cgs   = 1.98841586e33
length_cgs = 1.3914e11
time_cgs   = 1.2709152632111343e3
mu         = 1.0

<mesh_refinement>
refinement          = adaptive
num_levels          = 9
ncycle_check        = 10
refinement_interval = 10
max_nmb_per_rank    = 400
max_nmb_total       = 4000

<time>
evolution                = dynamic
integrator               = rk2
cfl_number               = 0.3
nlim                     = -1
tlim                     = 21.12
ndiag                    = 1
lat                      = true
lat_levels               = 7
lat_same_level           = false
lat_same_level_max_ratio = 2
lat_neighbor_limiter     = all
lat_min_bin_count        = 40
lat_diagnostics          = false
lat_defer_final_exchange = false

<hydro>
eos              = lte_table_chabrier2021_t13_helm_union_prad
table            = ../chabrier2021_t13_helm_union_prad_640.table
reconstruct      = plm
rsolver          = hlle
dfloor           = 1.0e-10
pfloor           = 3.42288e-15
tfloor_kelvin    = 1
sfloor           = 0.0
cs_ceil          = 15.0
vceil            = 15.0
fofc             = false
dual_energy      = true
dual_energy_eta1 = 1.0e-3
dual_energy_eta2 = 1.0e-4
lte_bounds       = clamp
lte_debug_checks = false

<gravity>
self_gravity = true
four_pi_G    = 1.0
threshold    = 1e-10
mg_bc        = multipole
fmg_ncycle   = 1
show_defect  = true
npresmooth   = 1
npostsmooth  = 2
rho_grav_min = 1.0e-9
solve_dt     = 0.03

<problem>
pgen_name                  = tde_external
user_srcs                  = true
star_radius                = 0.5
poly_n                     = 1.5
stellar_structure_mode     = eos_balanced
rho_floor                  = 1.0e-10
relax_damp                 = true
relax_tau                  = 0.02
relax_t_end                = 0.2
relax_radius               = 0.5
amp                        = 0.0
x_center                   = 0.0
y_center                   = 0.0
z_center                   = 0.0
vx_star                    = 0.0
vy_star                    = 0.0
vz_star                    = 0.0
external_bh_gravity_source = true
use_translating_frame      = true
frame_rho_min              = 1.0e-9
bh_grav_rho_min            = 1.0e-9
mass_ratio                 = 1e+06
beta                       = 1
ecc_bh                     = 1.0
theta_bh                   = 0
sep_initial                = 10
bh_softening               = 0.05
bh_excise_radius           = 6.36753
bh_potential               = wegg
bh_inner_boundary          = true

<refined_region0>
level = 8
x1min = -0.5
x1max = 0.5
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<amr_criterion0>
method = user

<tde_amr>
cells_per_radian    = 64
cells_per_thickness = 256
spine_frac          = 0.0001
midplane_finest     = false
bound_only          = false

<output1>
file_type = hst
dt        = 0.1

<output2>
file_type = bin
variable  = hydro_w
dt        = 1

<output4>
file_type = rst
dt        = 3

